#!/usr/bin/env python3
"""
Nightscout TUI - High-resolution Unicode terminal monitor for Nightscout CGM telemetry.
Zero external Python dependencies; renders via terminal Braille patterns & ANSI color codes.
"""

import argparse
import hashlib
import json
import os
import signal
import sys
import time
from datetime import datetime, timezone
import urllib.request
import urllib.error
import ssl

# Direction arrows mapping
DIRECTION_MAP = {
    "DoubleUp": "⇈",
    "SingleUp": "↑",
    "FortyFiveUp": "↗",
    "Flat": "→",
    "FortyFiveDown": "↘",
    "SingleDown": "↓",
    "DoubleDown": "⇊",
    "NOT COMPUTABLE": "─",
    "RATE OUT OF RANGE": "!",
}

# ANSI Color Codes
RESET = "\033[0m"
BOLD = "\033[1m"
GREEN = "\033[32m"
YELLOW = "\033[33m"
RED = "\033[31m"
CYAN = "\033[36m"
GRAY = "\033[90m"
WHITE = "\033[37m"
DIM = "\033[2m"

def parse_args():
    parser = argparse.ArgumentParser(prog="nightscout-tui", description="Nightscout TUI Monitor")
    parser.add_argument(
        "--url",
        default=os.environ.get("NIGHTSCOUT_URL", "https://nightscout.deepwatercreature.com"),
        help="Nightscout base URL (env: NIGHTSCOUT_URL)",
    )
    parser.add_argument(
        "--token",
        default=os.environ.get("NIGHTSCOUT_TOKEN", None),
        help="Nightscout API authentication token or secret (env: NIGHTSCOUT_TOKEN)",
    )
    parser.add_argument(
        "--token-file",
        default=os.environ.get("NIGHTSCOUT_TOKEN_FILE", None),
        help="Path to file containing Nightscout API token (env: NIGHTSCOUT_TOKEN_FILE)",
    )
    parser.add_argument(
        "--units",
        choices=["mg/dl", "mmol/l"],
        default=os.environ.get("DISPLAY_UNITS", "mg/dl").lower(),
        help="Display units: mg/dl or mmol/l (default: mg/dl)",
    )
    parser.add_argument(
        "--low",
        type=float,
        default=float(os.environ.get("TARGET_LOW", 70)),
        help="Target lower threshold in mg/dL (default: 70)",
    )
    parser.add_argument(
        "--high",
        type=float,
        default=float(os.environ.get("TARGET_HIGH", 180)),
        help="Target upper threshold in mg/dL (default: 180)",
    )
    parser.add_argument(
        "--count",
        type=int,
        default=int(os.environ.get("ENTRIES_COUNT", 48)),
        help="Number of historical entries to fetch (default: 48 = 4h)",
    )
    parser.add_argument(
        "--refresh",
        type=int,
        default=int(os.environ.get("REFRESH_SECONDS", 60)),
        help="Refresh interval in seconds (default: 60)",
    )
    parser.add_argument(
        "--once",
        action="store_true",
        help="Fetch and render once, then exit immediately",
    )
    parser.add_argument(
        "--insecure",
        "-k",
        action="store_true",
        default=os.environ.get("NIGHTSCOUT_INSECURE", "0").lower() in ("1", "true", "yes"),
        help="Allow self-signed or invalid SSL certificates (env: NIGHTSCOUT_INSECURE)",
    )
    parser.add_argument(
        "--ca-cert",
        default=os.environ.get("NIGHTSCOUT_CA_CERT", None),
        help="Path to custom CA certificate bundle (env: NIGHTSCOUT_CA_CERT)",
    )
    args = parser.parse_args()

    # Auto-discover token from file if not explicitly set via --token
    if not args.token:
        candidate_files = []
        if args.token_file:
            candidate_files.append(args.token_file)
        candidate_files.extend([
            os.path.expanduser("~/.secrets/nightscout-token"),
            os.path.expanduser("~/.config/nightscout/token"),
            "/run/agenix/nightscout-token",
            "/run/secrets/nightscout-token",
        ])
        for tf in candidate_files:
            if tf and os.path.exists(tf):
                try:
                    with open(tf, "r") as f:
                        val = f.read().strip()
                        if val:
                            args.token = val
                            break
                except OSError as e:
                    if args.token_file and tf == args.token_file:
                        sys.stderr.write(f"Warning: Could not read token file {tf}: {e}\n")

    return args

def format_bg(sgv, units):
    if units == "mmol/l":
        return f"{sgv / 18.0182:.1f}"
    return f"{int(round(sgv))}"

def get_color(sgv, low, high):
    if sgv < low:
        return RED
    elif sgv > high:
        return YELLOW
    return GREEN

def fetch_entries(base_url, token, count, insecure=False, ca_cert=None):
    url = f"{base_url.rstrip('/')}/api/v1/entries.json?count={count}"
    auth_header = None
    if token:
        # In Nightscout:
        # 1) Plaintext API secrets must be passed as sha1(secret) in the api-secret header.
        # 2) Subject tokens work via query parameter ?token=<token> or api-secret header.
        is_hex40 = (len(token) == 40 and all(c in "0123456789abcdefABCDEF" for c in token))
        sha1_hash = token if is_hex40 else hashlib.sha1(token.encode("utf-8")).hexdigest()
        
        if not is_hex40 or "-" in token:
            url += f"&token={token}"
        auth_header = sha1_hash

    req = urllib.request.Request(
        url,
        headers={
            "Accept": "application/json",
            "User-Agent": "NightscoutTUI/1.0",
            "X-Forwarded-Proto": "https",
        },
    )
    if auth_header:
        req.add_header("api-secret", auth_header)

    if insecure:
        ctx = ssl._create_unverified_context()
    elif ca_cert and os.path.exists(ca_cert):
        ctx = ssl.create_default_context(cafile=ca_cert)
    else:
        ctx = ssl.create_default_context()

    with urllib.request.urlopen(req, timeout=12, context=ctx) as resp:
        return json.loads(resp.read().decode("utf-8"))

from datetime import datetime, timezone, timedelta

def render_braille_graph(entries, target_low, target_high, units="mg/dl", width=60, height=12):
    """Draws a high-resolution scatter plot using Unicode 2x4 braille dot matrix and time-stamped X axis."""
    if not entries:
        return [], "", ""

    pts = list(reversed([p for p in entries if "sgv" in p and isinstance(p["sgv"], (int, float)) and "date" in p]))
    if not pts:
        return [], "", ""

    sgvs = [p["sgv"] for p in pts]
    min_val = min(min(sgvs) - 10, target_low - 10)
    max_val = max(max(sgvs) + 10, target_high + 20)
    val_range = max(1.0, max_val - min_val)

    t_start = pts[0]["date"] / 1000.0
    t_end = pts[-1]["date"] / 1000.0
    duration = max(1.0, t_end - t_start)

    pixel_w = width * 2
    pixel_h = height * 4
    grid = [[0 for _ in range(pixel_w)] for _ in range(pixel_h)]

    # Map each entry proportionally across the full time domain
    for p in pts:
        t = p["date"] / 1000.0
        px = int(round(((t - t_start) / duration) * (pixel_w - 1)))
        px = max(0, min(pixel_w - 1, px))
        val = p["sgv"]
        py = int(((val - min_val) / val_range) * (pixel_h - 1))
        py = max(0, min(pixel_h - 1, py))
        grid[py][px] = 1

    braille_rows = []
    for char_y in range(height - 1, -1, -1):
        row_str = ""
        current_y_val = min_val + ((char_y * 4 + 2) / float(pixel_h)) * val_range

        formatted_val = format_bg(current_y_val, units)
        axis_label = f"{formatted_val:>5s} │ "

        if abs(current_y_val - target_high) < (val_range / height):
            axis_label = f"{YELLOW}{formatted_val:>5s} ┄{RESET} "
        elif abs(current_y_val - target_low) < (val_range / height):
            axis_label = f"{RED}{formatted_val:>5s} ┄{RESET} "

        for char_x in range(width):
            px_start = char_x * 2
            py_start = char_y * 4
            code = 0
            dots = [
                (0, 0, 0x01), (0, 1, 0x02), (0, 2, 0x04), (1, 0, 0x08),
                (1, 1, 0x10), (1, 2, 0x20), (0, 3, 0x40), (1, 3, 0x80)
            ]
            for dx, dy, bit in dots:
                gy = py_start + dy
                gx = px_start + dx
                if 0 <= gy < pixel_h and 0 <= gx < pixel_w and grid[gy][gx]:
                    code |= bit

            char = chr(0x2800 + code) if code != 0 else " "
            row_str += char

        braille_rows.append(axis_label + row_str)

    # Determine X-axis ticks along time domain
    dur_hours = duration / 3600.0
    if dur_hours <= 2.5:
        step_minutes = 30
    elif dur_hours <= 6.0:
        step_minutes = 60
    elif dur_hours <= 12.0:
        step_minutes = 120
    else:
        step_minutes = 240

    start_dt = datetime.fromtimestamp(t_start, tz=timezone.utc).astimezone()
    end_dt = datetime.fromtimestamp(t_end, tz=timezone.utc).astimezone()

    start_min = start_dt.minute
    rem = start_min % step_minutes
    first_tick_dt = start_dt.replace(second=0, microsecond=0) + timedelta(minutes=(step_minutes - rem if rem != 0 else step_minutes))

    ticks = []
    cur = first_tick_dt
    while cur.timestamp() < t_end:
        col = int(round(((cur.timestamp() - t_start) / duration) * (width - 1)))
        lbl = cur.strftime("%H:%M")
        ticks.append((col, lbl))
        cur += timedelta(minutes=step_minutes)

    axis_chars = ["─"] * width
    for col, _ in ticks:
        if 0 <= col < width:
            axis_chars[col] = "┬"
    axis_line = "".join(axis_chars)

    # Build X-axis time label line
    label_chars = [" "] * width
    placed_spans = []

    # End label at right edge (latest reading time)
    end_lbl = end_dt.strftime("%H:%M")
    end_start = max(0, width - len(end_lbl))
    for i, ch in enumerate(end_lbl):
        if end_start + i < width:
            label_chars[end_start + i] = ch
    placed_spans.append((end_start, end_start + len(end_lbl)))

    # Start label at left edge if not colliding
    start_lbl = start_dt.strftime("%H:%M")
    if len(start_lbl) + 2 < end_start:
        for i, ch in enumerate(start_lbl):
            if i < width:
                label_chars[i] = ch
        placed_spans.append((0, len(start_lbl)))

    # Intermediate ticks
    for col, lbl in ticks:
        l_start = col - len(lbl) // 2
        l_end = l_start + len(lbl)
        if l_start < 0 or l_end > width:
            continue
        collides = any(not (l_end + 1 < s or l_start > e + 1) for s, e in placed_spans)
        if not collides:
            for i, ch in enumerate(lbl):
                label_chars[l_start + i] = ch
            placed_spans.append((l_start, l_end))

    time_labels = "".join(label_chars).rstrip()

    return braille_rows, axis_line, time_labels

def main():
    args = parse_args()

    # Handle clean termination
    def handle_sigint(_sig, _frame):
        sys.stdout.write(f"\n{RESET}Exiting Nightscout TUI.\n")
        sys.exit(0)

    signal.signal(signal.SIGINT, handle_sigint)
    signal.signal(signal.SIGTERM, handle_sigint)

    # Handle terminal resize
    if hasattr(signal, "SIGWINCH"):
        signal.signal(signal.SIGWINCH, lambda _sig, _frame: None)

    is_tty = sys.stdout.isatty()
    if not args.once and is_tty:
        sys.stdout.write("\033[2J\033[H")  # Clear screen and move cursor to home
        sys.stdout.flush()

    while True:
        try:
            entries = fetch_entries(args.url, args.token, args.count, insecure=args.insecure, ca_cert=args.ca_cert)
            if not entries:
                sys.stdout.write("No glucose entries returned from Nightscout.\n")
                if args.once:
                    break
                time.sleep(args.refresh)
                continue

            latest = entries[0]
            sgv = latest.get("sgv", 0)
            direction = latest.get("direction", "")
            arrow = DIRECTION_MAP.get(direction, "")

            delta_str = ""
            if len(entries) > 1:
                prev_sgv = entries[1].get("sgv", sgv)
                diff = sgv - prev_sgv
                if args.units == "mmol/l":
                    delta_str = f"{diff / 18.0182:+.1f} mmol/L"
                else:
                    delta_str = f"{int(round(diff)):+d} mg/dL"

            date_ms = latest.get("date", 0)
            entry_time = datetime.fromtimestamp(date_ms / 1000.0, tz=timezone.utc).astimezone()
            mins_ago = int((time.time() - (date_ms / 1000.0)) / 60.0)

            color = get_color(sgv, args.low, args.high)
            bg_display = format_bg(sgv, args.units)

            try:
                term_w, term_h = os.get_terminal_size()
            except OSError:
                term_w, term_h = (80, 24)

            # Dynamically stretch to fill terminal width and height
            graph_w = max(30, term_w - 10)
            graph_h = max(6, min(35, term_h - 11))

            output = ["\033[H"] if (not args.once and is_tty) else []
            output.append(f"{BOLD}Nightscout Live Monitor{RESET}  {GRAY}[{args.url}]{RESET}\n")
            output.append(f"  {color}{BOLD}{bg_display} {args.units} {arrow}{RESET}   {delta_str}   {GRAY}({mins_ago}m ago · {entry_time.strftime('%I:%M:%S %p')}){RESET}\n")
            
            low_disp = format_bg(args.low, args.units)
            high_disp = format_bg(args.high, args.units)
            output.append(f"  {GRAY}Target Range: {low_disp} – {high_disp} {args.units}{RESET}\n")

            rows, axis_line, time_labels = render_braille_graph(
                entries, args.low, args.high, units=args.units, width=graph_w, height=graph_h
            )

            for line in rows:
                output.append("  " + line)

            output.append(f"  {GRAY}{'':5s} └{axis_line}▶{RESET}")
            output.append(f"  {WHITE}{'':7s}{time_labels}{RESET}")

            sys.stdout.write("\n".join(output) + "\n")
            sys.stdout.flush()

        except Exception as e:
            sys.stdout.write(f"\r{RED}Fetch error: {e}{RESET}\n")
            if "CERTIFICATE_VERIFY_FAILED" in str(e):
                sys.stdout.write(f"  {YELLOW}Tip: Pass --insecure (-k) or set NIGHTSCOUT_INSECURE=1 for self-signed homelab certificates.{RESET}\n")
            sys.stdout.flush()

        if args.once:
            break

        time.sleep(args.refresh)

if __name__ == "__main__":
    main()
